# CMake build directories
/build/
/cmake-build-*/

# CMake output configured at the project root
/build_offline_data

# Runtime generated files
/data/generated/

#temp ignore
/data/

# Local secrets and environment configuration
/.env
/.env.*
!/.env.example

# Local agent metadata
/.agents/
/.codex/
/.claude/

# VS Code local settings
/.vscode/

# clangd local settings and cache
/.clangd
/.cache/

# CLion / IntelliJ local settings
/.idea/

# CMake files generated when configured in the source directory
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/Makefile
/CTestTestfile.cmake
/compile_commands.json

# Editor and operating-system temporary files
*.log
*.swp
*.swo
*~
.DS_Store
